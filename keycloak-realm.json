{
  "realm": "fitnessdevil",
  "enabled": true,
  "sslRequired": "none",
  "loginTheme": "fitness-devil",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 3600,

  "roles": {
    "realm": [
      { "name": "User", "description": "Standard user role" },
      { "name": "Admin", "description": "Administrator role" }
    ]
  },

  "clients": [
    {
      "clientId": "fitnessdevil-frontend",
      "name": "FitnessDevil Frontend",
      "description": "Next.js / Web UI",
      "enabled": true,

      "publicClient": false,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "frontend-secret",

      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,

      "protocol": "openid-connect",

      "redirectUris": [
        "http://localhost:3000/api/auth/callback/keycloak",

        "http://fitnessdevil-rso.italynorth.cloudapp.azure.com/api/auth/callback/keycloak",
        "https://fitnessdevil-rso.italynorth.cloudapp.azure.com/api/auth/callback/keycloak"
      ],

      "webOrigins": [
        "http://localhost:3000",
        "http://fitnessdevil-rso.italynorth.cloudapp.azure.com",
        "https://fitnessdevil-rso.italynorth.cloudapp.azure.com",
        "+"
      ],

      "attributes": {
        "access.token.lifespan": "3600",
        "post.logout.redirect.uris": "+",
        "pkce.code.challenge.method": "S256"
      },

      "defaultClientScopes": ["openid", "user-info"],
      "optionalClientScopes": ["offline_access"]
    },

    {
      "clientId": "fitnessdevil-core-api",
      "name": "FitnessDevil Core API",
      "enabled": true,

      "publicClient": false,
      "protocol": "openid-connect",
      "secret": "secret",

      "redirectUris": [
        "http://localhost:8080/q/dev-ui/*",
        "http://localhost:8080/q/dev-ui/quarkus-oidc/*",
        "http://localhost:8080/*",

        "http://fitnessdevil-rso.<italynorth>.cloudapp.azure.com/*",
        "https://fitnessdevil-rso.<italynorth>.cloudapp.azure.com/*"
      ],

      "webOrigins": [
        "http://localhost:8080",
        "http://fitnessdevil-rso.<italynorth>.cloudapp.azure.com",
        "https://fitnessdevil-rso.<italynorth>.cloudapp.azure.com",
        "*"
      ],

      "authorizationSettings": {
        "allowRemoteResourceManagement": true,
        "policyEnforcementMode": "ENFORCING",

        "resources": [
          {
            "name": "GraphQL Resource",
            "type": "urn:fitnessdevil:resources:graphql",
            "uris": ["/graphql"],
            "scopes": [{ "name": "graphql:query" }, { "name": "graphql:mutation" }]
          },
          {
            "name": "User Resource",
            "type": "urn:fitnessdevil:resources:user",
            "scopes": [{ "name": "user:read" }, { "name": "user:write" }, { "name": "user:list" }]
          }
        ],

        "policies": [
          {
            "name": "User Role Policy",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "roles": "[{\"id\":\"User\",\"required\":true}]"
            }
          },
          {
            "name": "Admin Role Policy",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "roles": "[{\"id\":\"Admin\",\"required\":true}]"
            }
          }
        ],

        "scopes": [
          { "name": "graphql:query" },
          { "name": "graphql:mutation" },
          { "name": "user:read" },
          { "name": "user:write" },
          { "name": "user:list" }
        ]
      }
    }
  ],

  "users": [
    {
      "username": "test@fitnessdevil.com",
      "email": "test@fitnessdevil.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Test",
      "lastName": "User",
      "credentials": [{ "type": "password", "value": "password123", "temporary": false }],
      "realmRoles": ["User"]
    },
    {
      "username": "admin@fitnessdevil.com",
      "email": "admin@fitnessdevil.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Admin",
      "lastName": "User",
      "credentials": [{ "type": "password", "value": "admin123", "temporary": false }],
      "realmRoles": ["User", "Admin"]
    },
    {
      "id": "11111111-1111-1111-1111-111111111111",
      "username": "john.doe@example.com",
      "email": "john.doe@example.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "John",
      "lastName": "Doe",
      "credentials": [{ "type": "password", "value": "password123", "temporary": false }],
      "realmRoles": ["User"]
    },
    {
      "id": "22222222-2222-2222-2222-222222222222",
      "username": "jane.smith@example.com",
      "email": "jane.smith@example.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Jane",
      "lastName": "Smith",
      "credentials": [{ "type": "password", "value": "password123", "temporary": false }],
      "realmRoles": ["User"]
    },
    {
      "id": "33333333-3333-3333-3333-333333333333",
      "username": "bob.johnson@example.com",
      "email": "bob.johnson@example.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Bob",
      "lastName": "Johnson",
      "credentials": [{ "type": "password", "value": "password123", "temporary": false }],
      "realmRoles": ["User"]
    },
    {
      "username": "service-account-fitnessdevil-core-api",
      "serviceAccountClientId": "fitnessdevil-core-api",
      "enabled": true,
      "realmRoles": ["User"]
    }
  ],

  "clientScopes": [
    {
      "name": "user-info",
      "description": "User information scope",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      },
      "protocolMappers": [
        {
          "name": "user-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "id",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "userId",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],

  "defaultDefaultClientScopes": [],
  "defaultOptionalClientScopes": ["offline_access"]
}
